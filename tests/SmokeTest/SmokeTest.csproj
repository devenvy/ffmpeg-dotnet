<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Console smoke test. Restores a freshly packed package from a local feed and
    proves the binaries actually work on the platform running it, rather than
    merely being present in the package.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SmokeTest</AssemblyName>
    <RootNamespace>SmokeTest</RootNamespace>
    <FFmpegPackage Condition="'$(FFmpegPackage)' == ''">DevEnvy.FFmpeg.Binaries.LGPLv2.Rid</FFmpegPackage>
    <FFmpegPackageVersion Condition="'$(FFmpegPackageVersion)' == ''">0.0.0-ci</FFmpegPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="$(FFmpegPackage)" Version="$(FFmpegPackageVersion)" />
  </ItemGroup>

  <!--
    With FFmpegAutoGenVersion (run-smoke-test.sh sets it to the newest FFmpeg.AutoGen of the
    series under test), the libraries are also bound through FFmpeg.AutoGen, the pairing the
    README documents. Desktop and Alpine only: AutoGen can't load the mobile builds.
  -->
  <PropertyGroup Condition="'$(FFmpegAutoGenVersion)' != ''">
    <DefineConstants>$(DefineConstants);AUTOGEN</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(FFmpegAutoGenVersion)' != ''">
    <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLoaded" Version="$(FFmpegAutoGenVersion)" />
  </ItemGroup>

</Project>
