<Project>

  <PropertyGroup>
    <!-- Resolved at release time to the newest FFmpeg.AutoGen matching the FFmpeg series
         being packed (8.1 -> 8.1.0, 9.0 -> 9.0.1.1). The default keeps a local build working. -->
    <FFmpegAutoGenVersion Condition="'$(FFmpegAutoGenVersion)' == ''">9.0.1.1</FFmpegAutoGenVersion>

    <Company>DevEnvy</Company>
    <Copyright>Copyright (c) DevEnvy</Copyright>
    <PackageProjectUrl>https://github.com/devenvy/ffmpeg-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/devenvy/ffmpeg-dotnet</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>false</IncludeSymbols>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

</Project>
